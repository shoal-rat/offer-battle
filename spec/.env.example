# All providers default to fully local operation.
NODE_ENV=development
PORT=3000
WEB_PORT=5173
DATA_DIR=./data
PUBLIC_BASE_URL=http://localhost:3000
TEXT_PROVIDER=local
TEXT_BASE_URL=
TEXT_API_KEY=
TEXT_MODEL=
IMAGE_PROVIDER=local
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
EXTRACT_PROVIDER=manual
EXTRACT_BASE_URL=
EXTRACT_API_KEY=
EXTRACT_MODEL=
VOICE_PROVIDER=off
VOICE_BASE_URL=
VOICE_API_KEY=
VOICE_MODEL=
MAX_UPLOAD_BYTES=10485760
GENERATION_CONCURRENCY=2
ROOM_IDLE_MINUTES=30
SESSION_SECRET=
# Generate a random persisted local secret on first startup when empty.
