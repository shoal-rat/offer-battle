# 默认无密钥即可玩。本文件中的配置只供服务端使用。
PORT=5173
HOST=0.0.0.0
# 跨域前端的精确 Origin，逗号分隔；不可带路径、末尾斜线或通配符。
# 留空仍允许直接访问后端的同源网页。本配置只在服务端生效。
# ALLOWED_ORIGINS=https://weikezhang.cn,https://shoal-rat.github.io
# 前端在 GitHub Pages 构建时单独设置 VITE_API_BASE_URL=https://your-api.example.com
# 仅在服务端只接受可信反向代理流量时设置；直接公网暴露时保持 0。
# TRUST_PROXY_HOPS=0
# 公网入口按客户端 IP 限流，普通出牌与读牌请求不受创建配额影响。
# RATE_WINDOW_MS=60000
# SESSION_RATE_LIMIT=60
# ROOM_RATE_LIMIT=120
# CREATION_RATE_LIMIT=60
# UPLOAD_RATE_LIMIT=20
# WS_RATE_LIMIT=120
# WS_MESSAGE_RATE_LIMIT=600
# WS_MAX_PER_SESSION=8
# WS_MAX_PER_IP=60
# WS_HEARTBEAT_MS=25000
# DATA_DIR=./data
# TURN_MS=30000
# 复制为 .env 后自动加载；已有 shell 环境变量优先。
# 可选创作适配器，彼此独立；不要把普通聊天接口直接填为图像接口。
# POST TEXT_PROVIDER_URL 接收 {model,offer,instruction}，返回 {name,description,quote}。
# TEXT_PROVIDER_URL=
# TEXT_PROVIDER_KEY=
# TEXT_MODEL=
# POST IMAGE_PROVIDER_URL 接收 {model,offer,size,instruction}，返回 {mime,base64}。
# IMAGE_PROVIDER_URL=
# IMAGE_PROVIDER_KEY=
# IMAGE_MODEL=
# 服务失败时保留本地角色与已编译规则卡；任务可在生成接口重试。
