{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "offer-battle-api",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-09-26",
  "workers_dev": true,
  "durable_objects": {"bindings": [
    {"name":"ACCOUNTS","class_name":"AccountRegistry"},
    {"name":"ROOMS","class_name":"BattleRoom"}
  ]},
  "migrations": [{"tag":"v1","new_sqlite_classes":["AccountRegistry","BattleRoom"]}],
  "vars": {
    "ALLOWED_ORIGINS": "https://weikezhang.cn,https://shoal-rat.github.io",
    "TURN_MS":"30000", "SETUP_MS":"20000",
    "ROOM_RETENTION_MS":"604800000", "WAITING_RETENTION_MS":"86400000",
    "MAX_SAVED_MATCHES":"30"
  },
  "observability": {"enabled": false}
}
